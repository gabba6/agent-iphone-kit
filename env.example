# Example configuration. Nothing here is required to run the offline tests.
#
# 1) agent-device signing and idle timeouts: put these "export" lines into ~/.zshenv so that every shell,
#    the agent-device daemon and iphone-mcp (which reads missing AGENT_DEVICE_* values from ~/.zshenv) see them.
export AGENT_DEVICE_IOS_TEAM_ID=YOUR_TEAM_ID
export AGENT_DEVICE_IOS_BUNDLE_ID=com.example.agentdevice.runner
export AGENT_DEVICE_IOS_RUNNER_IDLE_STOP_MS=1800000
export AGENT_DEVICE_DAEMON_IDLE_TIMEOUT_MS=1800000

# 2) iphone-capture (optional, environment variables; defaults shown)
# export IPHONE_RECORDINGS_DIR="$HOME/path/to/agent-iphone-kit/recordings"
# export IPHONE_CAPTURE_LAUNCH=auto          # auto | direct | app
# export IPHONE_CAPTURE_SETTLE_MS=2000       # wait after each recording (USB reconfiguration)
# export IPHONE_MIN_FREE_MB=1024
# export IPHONE_RECORDINGS_MAX_DAYS=14
# export IPHONE_RECORDINGS_MAX_GB=5

# 3) Local values for build and device tests: copy the lines below into .env.local in the repository root
#    (git-ignored; read by iphone/build.sh and iphone/test/device.test.mjs). Quote values that contain spaces.
#
# Code-signing identifier of helper/usb-screen and bundle ID of the app wrapper. Keep them stable once macOS
# granted camera access to the wrapper.
# IPHONE_HELPER_ID=com.example.usb-screen
# IPHONE_CAPTURE_BUNDLE_ID=com.example.iphone-capture
#
# Real-device tests (IPHONE_REAL_DEVICE=1): the app that must be in the foreground, a tap ("x,y" in points)
# that opens screen A with a known text, and a tap that returns to screen B with a known text.
# IPHONE_TEST_APP=com.apple.Preferences
# IPHONE_TEST_TAP_A=201,300
# IPHONE_TEST_TEXT_A="About"
# IPHONE_TEST_TAP_B=30,90
# IPHONE_TEST_TEXT_B="General"
